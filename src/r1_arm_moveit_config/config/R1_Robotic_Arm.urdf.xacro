<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="R1_Robotic_Arm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import R1_Robotic_Arm urdf file -->
    <xacro:include filename="$(find r1_arm)/urdf/R1_Robotic_Arm.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="R1_Robotic_Arm.ros2_control.xacro" />


    <xacro:R1_Robotic_Arm_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
